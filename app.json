{
  "expo": {
    "name": "CyberChic 95",
    "slug": "cyberchic95",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cyberchic",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#000080",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cyberchic95.wardrobe",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "CyberChic 95 needs camera access to photograph your clothes and digitize your wardrobe.",
        "NSPhotoLibraryUsageDescription": "CyberChic 95 needs photo library access to upload clothing images to your digital closet."
      }
    },
    "android": {
      "package": "com.cyberchic95.wardrobe",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000080",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you select garments for your wardrobe.",
          "cameraPermission": "The app accesses your camera to photograph garments."
        }
      ],
      "expo-web-browser"
    ]
  }
}
